<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.candyquest.view.component.ParticleEffectPane?>

<StackPane fx:id="mainStack" prefHeight="760.0" prefWidth="1100.0" 
           stylesheets="@../css/main.css" 
           xmlns="http://javafx.com/javafx/21" 
           xmlns:fx="http://javafx.com/fxml/1">
    
    <BorderPane fx:id="rootPane">
        <top>
            <HBox fx:id="headerBar" styleClass="header-bar" spacing="16.0">
                <VBox spacing="2.0">
                    <Label fx:id="appTitleLabel" styleClass="app-title" text="🍬 Candy Quest" />
                    <Label fx:id="taglineLabel" styleClass="tagline" text="Fruity Blast in 4 Exciting Data Structures" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Level, XP & Streak -->
                <HBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="userLevelLabel" styleClass="level-badge" text="Lvl 1" />
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <ProgressBar fx:id="xpProgressBar" prefWidth="140.0" progress="0.0" />
                        <Label fx:id="xpTextLabel" style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="0 XP" />
                    </VBox>
                    <Label fx:id="streakLabel" styleClass="streak-badge" text="🔥 1d" />
                </HBox>

                <!-- Navigation Action Buttons -->
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="homeNavButton" styleClass="nav-button" text="🏠 Worlds" />
                    <Button fx:id="searchNavButton" styleClass="nav-button" text="🔍 Search" />
                    <Button fx:id="dashboardNavButton" styleClass="nav-button" text="📊 Dashboard" />
                    <Button fx:id="playgroundNavButton" styleClass="nav-button" text="💻 Playground" />
                </HBox>
            </HBox>
        </top>

        <center>
            <StackPane fx:id="contentContainer" style="-fx-background-color: #1A1A2E;" />
        </center>
    </BorderPane>

    <!-- Global Particle Overlay Pane -->
    <ParticleEffectPane fx:id="globalParticlePane" mouseTransparent="true" />
</StackPane>
